[Unit]
Description=SpinPi - SpinSlicer CAL printer (web page, projector, ESP32 link)
After=network-online.target
Wants=network-online.target

[Service]
# root: needs port 80, the projector (DRM), the USB serial port and real-time priority for SpinProj
ExecStartPre=-/bin/sh -c 'setterm --cursor off --blank force </dev/tty1 >/dev/tty1 2>&1'
ExecStart=/usr/bin/python3 /opt/spinpi/spinpi.py --data /var/lib/spinpi --port 80 --projector auto --spinproj-arg=--rt --spinproj-arg=--cpu=3
# the old video player instead:  ... --engine mpv
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
