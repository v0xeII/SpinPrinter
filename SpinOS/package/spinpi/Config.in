config BR2_PACKAGE_SPINPI
	bool "spinpi"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_SERIAL
	select BR2_PACKAGE_SPINPROJ
	help
	  The printer service: web page, USB sticks, ESP32 link, print jobs.
	  Part of SpinSlicer.

comment "spinpi needs python3"
	depends on !BR2_PACKAGE_PYTHON3
