#!/bin/sh
# /data: the only place SpinOS writes to (videos, settings, Wi-Fi, print log).
# The image carries a small one; on the first start it grows to fill the whole card.
DISK=/dev/mmcblk0
PART=${DISK}p3

case "$1" in
start)
	e2fsck -p $PART >/dev/null 2>&1
	mount -t ext4 -o noatime $PART /data || { echo "S01data: cannot mount $PART"; exit 1; }
	if [ ! -e /data/.grown ]; then
		echo "S01data: first start, growing /data to the whole card"
		umount /data
		echo ", +" | sfdisk --no-reread --quiet -N 3 $DISK && partx -u -n 3 $DISK
		e2fsck -fy $PART >/dev/null 2>&1
		resize2fs $PART >/dev/null 2>&1
		mount -t ext4 -o noatime $PART /data || exit 1
		touch /data/.grown
		sync
	fi
	mkdir -p /data/spinpi /data/wifi /data/ssh
	mkdir -p /run/avahi-services  # /etc/avahi/services points here (spinpi.py writes the mDNS service)
	;;
stop)
	sync
	umount /data 2>/dev/null
	;;
esac
