#!/bin/sh
# SpinOS network: the home Wi-Fi if we know one, otherwise the printer's own access point
# "SpinSlicer-XXXX" (open, 192.168.4.1) where the web page lets you pick the home Wi-Fi.
#   spinnet start | status | scan | connect <ssid> <password> | forget | ap
IF=wlan0
CONF=/data/wifi/wpa_supplicant.conf
AP_IP=192.168.4.1
RUN=/run/spinnet
mkdir -p $RUN /data/wifi 2>/dev/null

ap_name() {
	m=$(tr -d ':\n' </sys/class/net/$IF/address 2>/dev/null | tail -c 4 | tr a-f A-F)
	echo "SpinSlicer-${m:-0000}"
}

stop_all() {
	killall -q wpa_supplicant hostapd dnsmasq udhcpc ntpd 2>/dev/null
	sleep 0.5
	ip addr flush dev $IF 2>/dev/null
}

scan_now() {  # "signal<TAB>ssid" lines, cached for when the radio is busy being an access point
	ip link set $IF up 2>/dev/null
	iw dev $IF scan 2>/dev/null | awk '
		/^BSS / { if (ssid != "") print sig "\t" ssid; ssid=""; sig=-100 }
		/signal:/ { sig=$2 }
		/SSID: / { sub(/^[ \t]*SSID: /, ""); ssid=$0 }
		END { if (ssid != "") print sig "\t" ssid }' >$RUN/scan.new && mv $RUN/scan.new $RUN/scan
}

ap() {
	scan_now
	stop_all
	ip link set $IF up
	ip addr add $AP_IP/24 dev $IF
	cat >$RUN/hostapd.conf <<CONF
interface=$IF
driver=nl80211
ssid=$(ap_name)
hw_mode=g
channel=6
country_code=RU
auth_algs=1
CONF
	hostapd -B $RUN/hostapd.conf >/dev/null
	# every name resolves to the printer, so phones open the page by themselves (captive portal)
	dnsmasq --conf-file=/dev/null --interface=$IF --bind-interfaces --no-resolv --leasefile-ro \
		--dhcp-range=192.168.4.10,192.168.4.200,1h --dhcp-option=3,$AP_IP --dhcp-option=6,$AP_IP \
		--address=/#/$AP_IP
	echo ap >$RUN/mode
}

client() {
	stop_all
	ip link set $IF up
	wpa_supplicant -B -D nl80211 -i $IF -c $CONF -C /run/wpa_supplicant >/dev/null || return 1
	udhcpc -b -i $IF -x hostname:spinslicer -p $RUN/udhcpc.pid >/dev/null 2>&1
	for i in $(seq 30); do
		if ip -4 addr show $IF | grep -q 'inet '; then
			echo client >$RUN/mode
			ntpd -p pool.ntp.org 2>/dev/null  # the Pi has no clock: get the time for the print log
			return 0
		fi
		sleep 1
	done
	return 1
}

case "$1" in
start)
	modprobe brcmfmac 2>/dev/null
	for i in $(seq 10); do [ -e /sys/class/net/$IF ] && break; sleep 0.5; done
	if [ -s $CONF ] && client; then exit 0; fi
	ap
	;;
connect)
	[ -n "$2" ] || { echo "usage: spinnet connect <ssid> [password]"; exit 2; }
	if [ -n "$3" ]; then
		wpa_passphrase "$2" "$3" | grep -v '#psk=' >$CONF.new || exit 1
	else
		printf 'network={\n\tssid="%s"\n\tkey_mgmt=NONE\n}\n' "$2" >$CONF.new
	fi
	printf 'ctrl_interface=/run/wpa_supplicant\ncountry=RU\n' | cat - $CONF.new >$CONF.tmp && sync && mv $CONF.tmp $CONF && rm -f $CONF.new
	sync
	sleep 2  # let the page answer the phone before the access point goes away
	client || { mv $CONF $CONF.failed; ap; }
	;;
forget)
	rm -f $CONF
	sync
	ap
	;;
ap)
	ap
	;;
scan)
	[ "$(cat $RUN/mode 2>/dev/null)" = client ] && scan_now
	cat $RUN/scan 2>/dev/null
	;;
status)
	mode=$(cat $RUN/mode 2>/dev/null || echo none)
	echo "mode=$mode"
	echo "ap_name=$(ap_name)"
	echo "ip=$(ip -4 addr show $IF 2>/dev/null | awk '/inet /{sub(/\/.*/, "", $2); print $2; exit}')"
	[ "$mode" = client ] && echo "ssid=$(iw dev $IF link 2>/dev/null | sed -n 's/^[ \t]*SSID: //p')"
	;;
*)
	echo "usage: spinnet start|status|scan|connect <ssid> <password>|forget|ap"
	exit 2
	;;
esac
